<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/tajawal_bold</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="SoukChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="chipIconVisible">true</item>
        <item name="chipIconSize">20dp</item>
        <item name="chipIconTint">@null</item>
        <item name="iconStartPadding">6dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">100dp</item>
        <item name="android:textColor">@color/sub_text</item>
        <item name="android:fontFamily">@font/tajawal_regular</item>
    </style>
</resources>