<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/default_background"
    tools:context=".SuccessActivity">

    <View
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/loading_background"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topHeader"
        app:layout_constraintVertical_bias="0.42">

        <FrameLayout
            android:id="@+id/successIconContainer"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_pill_green"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivSuccessIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:contentDescription="@string/success_celebration"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_party_popper"
                android:translationX="10dp"
                android:translationY="-10dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSuccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/cormorant_garamond_bold"
            android:text="@string/you_re_in"
            android:textColor="@color/tertiary"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/tvSuccessSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="40dp"
            android:fontFamily="@font/cormorant_garamond_regular"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/welcome_to_souk_hirfa_nyour_account_has_been_created_ndiscover_artisans_near_you"
            android:textColor="@color/sub_text"
            android:textSize="18sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>