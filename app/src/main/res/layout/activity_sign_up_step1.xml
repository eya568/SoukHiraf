<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_button"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".SignUpStep1Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/loading_background"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cormorant_garamond_italic"
                android:text="@string/create_account_title"
                android:textColor="@color/white"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:fontFamily="@font/tajawal_regular"
                android:text="@string/step_1_subtitle"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-24dp"
            android:background="@drawable/bg_form_sheet"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cormorant_garamond_italic"
                android:text="@string/signup_as_owner"
                android:textColor="@color/black"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/cormorant_garamond_italic"
                android:text="@string/tell_us_shop"
                android:textColor="@color/primary"
                android:textSize="16sp" />

            <!-- First / Last name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="@string/first_name_label" />

                    <EditText
                        android:id="@+id/etFirstName"
                        style="@style/FieldInput"
                        android:hint="@string/first_name_hint"
                        android:inputType="textPersonName" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="@string/last_name_label" />

                    <EditText
                        android:id="@+id/etLastName"
                        style="@style/FieldInput"
                        android:hint="@string/last_name_hint"
                        android:inputType="textPersonName" />
                </LinearLayout>
            </LinearLayout>

            <!-- Email -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="16dp"
                android:text="@string/email_label" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/FieldInput"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress" />

            <!-- Phone -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="16dp"
                android:text="@string/phone_label" />

            <EditText
                android:id="@+id/etPhone"
                style="@style/FieldInput"
                android:hint="@string/phone_hint"
                android:inputType="phone" />

            <!-- Password -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="16dp"
                android:text="@string/password_label" />

            <EditText
                android:id="@+id/etPassword"
                style="@style/FieldInput"
                android:hint="@string/password_hint"
                android:inputType="textPassword" />

            <!-- Confirm password -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="16dp"
                android:text="@string/confirm_password_label" />

            <EditText
                android:id="@+id/etConfirmPassword"
                style="@style/FieldInput"
                android:hint="@string/confirm_password_hint"
                android:inputType="textPassword" />

            <!-- Continue -->

            <!-- Divider -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="@color/primary"
                android:fontFamily="@font/tajawal_bold"
                android:gravity="center"
                android:text="@string/continue_arrow"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:alpha="0.25"
                    android:background="@color/sub_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/tajawal_regular"
                    android:text="@string/or_continue_with"
                    android:textColor="@color/sub_text"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:alpha="0.25"
                    android:background="@color/sub_text" />
            </LinearLayout>

            <!-- Google -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/white"
                android:fontFamily="@font/tajawal_bold"
                android:text="@string/continue_google"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="15sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@null"
                app:strokeColor="@color/input_border" />

            <!-- Already have an account? Sign in -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/tajawal_regular"
                    android:text="@string/have_account"
                    android:textColor="@color/sub_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSignIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/tajawal_regular"
                    android:paddingStart="6dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="8dp"
                    android:text="@string/sign_in_link"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>