<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_button"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".SignUpStep1Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/loading_background"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cormorant_garamond_italic"
                android:text="@string/create_account_title"
                android:textColor="@color/white"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:fontFamily="@font/tajawal_regular"
                android:text="@string/step_3_subtitle"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-24dp"
            android:background="@drawable/bg_form_sheet"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">
            <TextView
                style="@style/FieldLabel"
                android:text="@string/shop_business_name" />

            <EditText
                android:id="@+id/etBusinessName"
                style="@style/FieldInput"
                android:autofillHints="dd"
                android:hint="@string/name_of_shop"
                android:inputType="text" />
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="40dp"
                android:text="@string/type_of_business" />

            <EditText
                android:id="@+id/etBusinessType"
                style="@style/FieldInput"
                android:autofillHints="Select type"
                android:hint="@string/select_type"
                android:inputType="text" />
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="40dp"
                android:text="@string/what_are_you_looking_to_source" />
            <!-- Wrap your chips in a ChipGroup -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSourcing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="false"
                app:selectionRequired="false">

                <!-- Baking Goods -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBakingGoods"
                    style="@style/SoukChipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_baking_goods"
                    app:chipIcon="@drawable/ic_baking" />

                <!-- Art -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipArt"
                    style="@style/SoukChipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_art"
                    app:chipIcon="@drawable/ic_art" />

                <!-- Textiles -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTextiles"
                    style="@style/SoukChipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_textiles"
                    app:chipIcon="@drawable/ic_textiles" />

                <!-- Candles -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCandles"
                    style="@style/SoukChipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_candles"
                    app:chipIcon="@drawable/ic_candles" />

                <!-- Ceramic -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCeramic"
                    style="@style/SoukChipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_ceramic"
                    app:chipIcon="@drawable/ic_ceramic" />
                <!-- Jewelery -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipJewelery"
                    style="@style/SoukChipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_jewelry"
                    app:chipIcon="@drawable/ic_jewelery" />
                <!-- Woodwork -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWoodwork"
                    style="@style/SoukChipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_woodwork"
                    app:chipIcon="@drawable/ic_woodwork" />

            </com.google.android.material.chip.ChipGroup>
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="40dp"
                android:text="@string/anything_else_you_d_like_artisans_to_know" />

            <EditText
                android:id="@+id/etShopBio"
                style="@style/FieldInput"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:gravity="top|start"
                android:hint="@string/e_g_we_prefer_weekly_deliveries_eco_friendly_packaging"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="12dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinueOwner"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/primary"
                android:fontFamily="@font/tajawal_bold"
                android:gravity="center"
                android:text="@string/continue_arrow"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackOwner"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/secondary_button"
                android:fontFamily="@font/tajawal_bold"
                android:gravity="center"
                android:text="@string/go_back"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>